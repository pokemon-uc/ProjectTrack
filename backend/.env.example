PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173,http://localhost:5000

DB_USER=postgres
DB_HOST=localhost
DB_NAME=projecttrack
DB_PASSWORD=replace_with_your_local_database_password
DB_PORT=5432
DB_SSL=false
# DATABASE_URL=postgresql://user:password@host:5432/database

# Leave REDIS_URL unset to use in-memory limiting during local development.
# Set it to enable Redis-backed limiting.
REDIS_URL=redis://127.0.0.1:6379
REDIS_REQUIRED=false

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=2h