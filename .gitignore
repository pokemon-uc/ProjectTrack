# Dependencies
**/node_modules/

# Environment files and secrets
**/.env
**/.env.*
!**/.env.example
!**/.env.docker.example
# User uploads and generated files
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# Build output
frontend/dist/
backend/dist/
**/build/

# Test and coverage output
**/coverage/
**/.nyc_output/
**/playwright-report/
**/test-results/

# Logs
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime files
**/*.pid
**/*.seed
**/*.pid.lock

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temporary files
**/*.tmp
**/*.temp
**/.cache/

# Local database backups
**/*.sql.gz
**/*.dump
**/*.backup
